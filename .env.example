# Demo mode is an explicit, offline heat-pump scenario with synthetic sources.
# For live web search, set SEARCH_PROVIDER=browserbase and supply your own Browserbase key.
SEARCH_PROVIDER=demo
BROWSERBASE_API_KEY=

# Server-enforced ceilings: 1-10 sources, 1000-30000 extracted characters.
MAX_SEARCH_RESULTS=3
MAX_SOURCE_CHARS=20000
FETCH_TIMEOUT_MS=10000
MAX_RESPONSE_BYTES=2000000
MAX_REDIRECTS=3
